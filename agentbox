#!/usr/bin/env bash
# AgentBox - Simplified container environment for Claude development
# Automatically rebuilds when Dockerfile changes and uses ephemeral containers with persistent caches

set -euo pipefail

if ((BASH_VERSINFO[0] < 4)); then
    echo "Error: Bash 4.0 or later required (found ${BASH_VERSION}). This project requires 4.0+ to simplify the code." >&2
    if [[ $OSTYPE == darwin* ]]; then
        echo "Due to GPL licensing, macOS ships with Bash 3.2, which is archaic." >&2
        echo "Try: brew install bash, then ensure /opt/homebrew/bin is in your PATH" >&2
    fi
    exit 1
fi

# Configuration
# Resolve symlinks to get the real script location (allows installation as symlink)
readonly SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
readonly PROJECT_DIR="$(pwd)"
readonly PROJECT_NAME="$(basename "$PROJECT_DIR")"
readonly DOCKERFILE_PATH="${SCRIPT_DIR}/Dockerfile"
readonly ENTRYPOINT_PATH="${SCRIPT_DIR}/entrypoint.sh"
DEPENDENCIES_PATH="${SCRIPT_DIR}/opencode-dependencies.cjs"
OPENCODE_VERSION=2
readonly IMAGE_NAME="agentbox:latest"
readonly CONTAINER_PREFIX="agentbox"

# Set by check_runtime() in main()
RUNTIME=""
OPENCODE_BASE_MOUNTS=()
OPENCODE_WRITABLE_SOURCES=()
OPENCODE_WRITABLE_DESTINATIONS=()

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m' # No Color

# Helper functions
log_info() { echo -e "${BLUE}ℹ${NC}  $1"; }
log_success() { echo -e "${GREEN}✅${NC} $1"; }
log_warning() { echo -e "${YELLOW}⚠${NC}  $1"; }
log_error() { echo -e "${RED}❌${NC} $1" >&2; }
log_build() { echo -e "${CYAN}🔨${NC} $1"; }

# Detect available container runtime
detect_runtime() {
    if command -v docker &> /dev/null && docker info &> /dev/null; then
        # Check if docker is actually a Podman shim - if so, use podman directly
        # to ensure Podman-specific flags (e.g. --userns=keep-id) are applied.
        if docker info 2>/dev/null | grep -q "podman" && command -v podman &> /dev/null; then
            echo "podman"
        else
            echo "docker"
        fi
    elif command -v podman &> /dev/null && podman info &> /dev/null; then
        echo "podman"
    else
        return 1
    fi
}

# Check if a container runtime is available
check_runtime() {
    local runtime
    runtime=$(detect_runtime) || {
        log_error "No container runtime found. Please install Docker or Podman."
        exit 1
    }
    echo "$runtime"
}

# Calculate hash for a file
calculate_hash() {
    local file="$1"
    if [[ -f "$file" ]]; then
        sha256sum "$file" | cut -d' ' -f1
    else
        echo "none"
    fi
}

# Get container name for current project
get_project_id() {
    echo -n "$PROJECT_DIR" | sha256sum | cut -c1-12
}

get_container_name() {
    local project_id="$1"
    local random_suffix=$(printf '%04x%04x' $RANDOM $RANDOM)
    echo "${CONTAINER_PREFIX}-${project_id}-${random_suffix}"
}

parse_opencode_version() {
    local text="$1"
    if [[ "$text" =~ (^|[[:space:]])v?([0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)([[:space:]]|$) ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
    else
        return 1
    fi
}

select_opencode_version() {
    local tool="$1" output version
    if ! command -v opencode >/dev/null 2>&1; then
        printf '%s\n' 2
        return
    fi
    if output=$(opencode --version 2>/dev/null) && version=$(parse_opencode_version "$output"); then
        if [[ "$version" == 2.* ]]; then
            printf '%s\n' "$version"
            return
        fi
    fi
    if [[ "$tool" == opencode ]]; then
        log_error "Host OpenCode must report a V2 version before sharing its data."
        return 1
    fi
    printf '%s\n' 2
}

calculate_image_hash() {
    printf '%s\0' "$(calculate_hash "$DOCKERFILE_PATH")" \
        "$(calculate_hash "$ENTRYPOINT_PATH")" \
        "$(calculate_hash "$DEPENDENCIES_PATH")" "$OPENCODE_VERSION" |
        sha256sum | cut -d' ' -f1
}

# Check if image needs rebuild
needs_rebuild() {
    local combined_hash
    combined_hash=$(calculate_image_hash)

    # Check if image exists
    if ! $RUNTIME image inspect "$IMAGE_NAME" &> /dev/null; then
        return 0  # Needs rebuild - image doesn't exist
    fi

    # Get stored hash from image
    local stored_hash=$($RUNTIME inspect "$IMAGE_NAME" \
        --format '{{ index .Config.Labels "agentbox.hash" }}' 2>/dev/null || echo "none")

    # Compare hashes
    if [[ "$combined_hash" != "$stored_hash" ]]; then
        return 0  # Needs rebuild
    fi

    # Rebuild if image is older than 48 hours to get latest tool versions
    local built_at=$($RUNTIME inspect "$IMAGE_NAME" \
        --format '{{ index .Config.Labels "agentbox.built" }}' 2>/dev/null || echo "")
    if [[ -n "$built_at" ]]; then
        local built_ts=$(date -d "$built_at" +%s 2>/dev/null || echo 0)
        local now_ts=$(date +%s)
        local age_hours=$(( (now_ts - built_ts) / 3600 ))
        if (( age_hours >= 48 )); then
            return 0  # Needs rebuild - image too old
        fi
    fi

    return 1  # No rebuild needed
}

# Build Docker image
build_image() {
    local combined_hash
    combined_hash=$(calculate_image_hash)

    log_build "Building AgentBox image (this may take a few minutes on first run)..."

    # Get current user/group IDs
    local user_id=$(id -u)
    local group_id=$(id -g)

    # Build with progress output
    local build_timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if $RUNTIME build \
        --build-arg USER_ID="${user_id}" \
        --build-arg GROUP_ID="${group_id}" \
        --build-arg USERNAME="agent" \
        --build-arg BUILD_TIMESTAMP="${build_timestamp}" \
        --build-arg "OPENCODE_VERSION=$OPENCODE_VERSION" \
        --label "agentbox.hash=${combined_hash}" \
        --label "agentbox.version=1.0.0" \
        --label "agentbox.opencode_version=$OPENCODE_VERSION" \
        --label "agentbox.built=${build_timestamp}" \
        -t "$IMAGE_NAME" \
        "$SCRIPT_DIR" ; then
        log_success "Image built successfully!"
        $RUNTIME image prune -f --filter "label=agentbox.version" &>/dev/null || true
        return 0
    else
        log_error "Failed to build image"
        return 1
    fi
}

expand_tilde() {
    local path="$1"
    if [[ "$path" =~ ^~ ]]; then
        echo "${path/#\~/$HOME}"
    else
        echo "$path"
    fi
}

has_path_traversal() {
    local path="$1"
    [[ "$path" =~ (^|/)\.\.(/|$) ]]
}

is_absolute_path() {
    local path="$1"
    [[ "$path" =~ ^/ ]]
}

is_critical_system_dir() {
    local path="$1"
    [[ "$path" =~ ^/(bin|sbin|boot|lib|lib64)(/|$) ]]
}

is_system_dir() {
    local path="$1"
    [[ "$path" =~ ^/(etc|var|usr|sys|proc|dev)(/|$) ]]
}

is_duplicate_dir() {
    local path="$1"
    local -n check_dirs_ref=$2

    for existing_dir in "${check_dirs_ref[@]}"; do
        if [[ "$path" == "$existing_dir" ]]; then
            return 0
        fi
    done
    return 1
}

validate_dir_path() {
    local dir="$1"
    local -n validated_dirs_ref=$2
    local project_realpath="$3"

    dir=$(expand_tilde "$dir")

    if has_path_traversal "$dir"; then
        log_error "Path traversal not allowed: $dir"
        return 1
    fi

    if ! is_absolute_path "$dir"; then
        log_error "Directory must be absolute path: $dir"
        return 1
    fi

    if [[ ! -d "$dir" ]]; then
        log_error "Directory not found: $dir"
        return 1
    fi

    local dir_realpath
    dir_realpath=$(realpath "$dir" 2>/dev/null) || {
        log_error "Cannot resolve path: $dir"
        return 1
    }

    if is_critical_system_dir "$dir_realpath"; then
        log_error "Mounting critical system directory not allowed: $dir_realpath"
        return 1
    fi

    if [[ "$dir_realpath" == "$project_realpath" ]]; then
        log_warning "Skipping duplicate: $dir (already mounted as project directory)"
        return 0  # Not an error, just skip
    fi

    if is_duplicate_dir "$dir_realpath" validated_dirs_ref; then
        log_warning "Skipping duplicate directory: $dir"
        return 0  # Not an error, just skip
    fi

    if is_system_dir "$dir_realpath"; then
        log_warning "Mounting system directory: $dir_realpath (proceed with caution)"
    fi

    validated_dirs_ref+=("$dir_realpath")
    return 0
}

# Mount symlink targets from a directory so symlinks resolve inside the container
mount_symlink_targets() {
    local dir="$1"
    local -n symlink_mounts_ref=$2

    if [[ ! -d "$dir" ]]; then
        return 0
    fi

    local dir_realpath
    dir_realpath=$(realpath "$dir")

    for entry in "$dir"/*; do
        if [[ -L "$entry" ]]; then
            local target
            target=$(readlink -f "$entry" 2>/dev/null) || continue

            # Only mount if target is outside the directory (would be unreachable in container)
            if [[ "$target" != "$dir_realpath/"* ]]; then
                if [[ -e "$target" ]]; then
                    symlink_mounts_ref+=(-v "$target:$target:z")
                    log_info "Symlink target mounted: $(basename "$entry") -> $target"
                else
                    log_warning "Symlink target not found: $(basename "$entry") -> $target"
                fi
            fi
        fi
    done
}

# Mount host clipboard sockets so Claude CLI can read image pastes.
# Claude shells out to wl-paste/xclip, which need access to the host's
# Wayland/X11 socket. Without this, image paste silently fails.
mount_clipboard_sockets() {
    local -n clipboard_mounts_ref=$1

    if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
        local wayland_sock="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
        if [[ -S "$wayland_sock" ]]; then
            clipboard_mounts_ref+=(
                -v "${wayland_sock}:/tmp/.agentbox-wayland"
                --env "WAYLAND_DISPLAY=/tmp/.agentbox-wayland"
            )
            log_info "Wayland socket mounted (enables image paste)"
        fi
    fi

    if [[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]]; then
        clipboard_mounts_ref+=(
            -v "/tmp/.X11-unix:/tmp/.X11-unix:ro"
            --env "DISPLAY=${DISPLAY}"
        )
        log_info "X11 socket mounted (enables image paste fallback)"
    fi
}

# Mount additional dirs to Docker mount options
mount_additional_dirs() {
    local -n mount_opts_ref=$1
    shift
    local extra_dirs=("$@")

    # Return early if no dirs to mount
    if [[ ${#extra_dirs[@]} -eq 0 ]]; then
        return 0
    fi

    for extra_dir in "${extra_dirs[@]}"; do
        mount_opts_ref+=(-v "$extra_dir:$extra_dir:z")
        log_info "Mounting additional directory: $extra_dir"
    done
}

build_mount_opts() {
    local -n mounts_ref=$1
    local project_id="$2"
    local tool="$3"
    local -n dirs_ref=$4
    local mount_dir="$5"

    mounts_ref=(
        -v "$mount_dir:$mount_dir:z"
        --env "PROJECT_DIR=$PROJECT_DIR"
    )

    mount_additional_dirs mounts_ref "${dirs_ref[@]}"

    if [[ -f "${HOME}/.gitconfig" ]]; then
        mounts_ref+=(-v "${HOME}/.gitconfig:/tmp/host_gitconfig:ro")
    fi

    local gh_config="${HOME}/.config/gh"
    if [[ -d "${gh_config}" ]]; then
        mounts_ref+=(-v "${gh_config}:/home/agent/.config/gh:ro")
        log_info "GitHub CLI auth mounted (read-only)"
    fi

    local agentbox_ssh="${HOME}/.agentbox/ssh"
    if [[ -d "${agentbox_ssh}" ]]; then
        mounts_ref+=(-v "${agentbox_ssh}:/home/agent/.ssh:ro")
        log_info "AgentBox SSH directory mounted (read-only)"
    else
        log_warning "SSH not configured. Run 'agentbox ssh-init' to enable SSH operations."
    fi

    mount_clipboard_sockets mounts_ref

    local cache_dir="${HOME}/.cache/agentbox/${project_id}"
    mkdir -p "${cache_dir}/npm" "${cache_dir}/pip" "${cache_dir}/maven" "${cache_dir}/gradle"

    mounts_ref+=(
        -v "${cache_dir}/npm:/home/agent/.npm"
        -v "${cache_dir}/pip:/home/agent/.cache/pip"
        -v "${cache_dir}/maven:/home/agent/.m2"
        -v "${cache_dir}/gradle:/home/agent/.gradle"
    )

    local history_dir="${HOME}/.agentbox/projects/${project_id}/history"
    mkdir -p "${history_dir}"

    mounts_ref+=(
        -v "${history_dir}:/home/agent/.shell_history"
        --env "HISTFILE=/home/agent/.shell_history/zsh_history"
    )

    if [[ "$tool" == "opencode" ]]; then
        OPENCODE_BASE_MOUNTS=("$mount_dir" "$PROJECT_DIR" "${dirs_ref[@]}")
        local -a opencode_mounts=()
        build_opencode_mounts opencode_mounts "$project_id" || return 1
        mounts_ref+=("${opencode_mounts[@]}")
        local -a herdr_args=()
        build_herdr_args herdr_args || return 1
        mounts_ref+=("${herdr_args[@]}")
        mounts_ref+=(--env "AGENTBOX_OPENCODE_VERSION=$OPENCODE_VERSION")
        log_info "OpenCode configuration and auth mounted selectively"
    else
        local claude_dir="${HOME}/.claude"
        mkdir -p "$claude_dir"

        mounts_ref+=(
            -v "${claude_dir}:/home/agent/.claude"
            --env "CLAUDE_CONFIG_DIR=/home/agent/.claude"
            --env "HOST_HOME=${HOME}"
        )
        mount_symlink_targets "$claude_dir" mounts_ref
        log_info "Claude CLI configuration mounted"
    fi

    mounts_ref+=(--env "TOOL=$tool")

    if [[ -f "$PROJECT_DIR/.envrc" ]]; then
        local host_direnv_allow="${HOME}/.local/share/direnv/allow"
        if [[ -d "$host_direnv_allow" ]]; then
            mounts_ref+=(-v "${host_direnv_allow}:/tmp/host_direnv_allow:ro")
            log_info "Host direnv approvals will be translated to container"
        fi
    fi
}

build_container_cmd() {
    local -n cmd_ref=$1
    local shell_mode="$2"
    local admin_mode="$3"
    local tool="$4"
    shift 4
    local args=("$@")

    if [[ "$shell_mode" == "true" ]]; then
        if [[ "$admin_mode" == "true" ]]; then
            if [[ ${#args[@]} -gt 0 ]]; then
                cmd_ref=(bash -c "echo '🔒 Admin shell - sudo access enabled' && exec \"\$@\"" -- "${args[@]}")
            else
                cmd_ref=(bash -c "echo '🔒 Admin shell - sudo access enabled' && exec /bin/zsh")
            fi
        else
            cmd_ref=("${args[@]:-/bin/zsh}")
        fi
        return
    fi

    local tool_cmd
    if [[ "$tool" == "opencode" ]]; then
        tool_cmd="opencode --standalone"
    else
        tool_cmd="claude --dangerously-skip-permissions"
    fi

    if [[ ${#args[@]} -gt 0 ]]; then
        local escaped_args=""
        for arg in "${args[@]}"; do
            escaped_args+=" $(printf '%q' "$arg")"
        done
        tool_cmd="$tool_cmd$escaped_args"
    fi
    cmd_ref=(zsh -c "source ~/.zshrc && exec $tool_cmd")
}

append_opencode_mount() {
    local -n output_ref="$1" registry_ref="$5"
    local source destination="$3" mode="$4"
    if [[ "$mode" != ro && "$mode" != rw ]] ||
        [[ "$2$destination" == *$'\n'* || "$2$destination" == *$'\r'* ||
           "$2$destination" == *$'\t'* || "$2" == *:* || "$destination" == *:* ]] ||
        [[ "$2" != /* || "$destination" != /* ]]; then
        log_error "Unsupported OpenCode mount path or mode."
        return 1
    fi
    source=$(realpath -e -- "$2") || {
        log_error "Missing OpenCode dependency: $2"
        return 1
    }
    if [[ "$source" == *:* || "$source" == *$'\n'* || "$source" == *$'\r'* || "$source" == *$'\t'* ]]; then
        log_error "Unsupported resolved OpenCode mount path."
        return 1
    fi
    local canonical_home
    canonical_home=$(realpath -e -- "$HOME") || return 1
    case "$source" in
        /|/home|/usr|/usr/bin|/usr/sbin|/usr/lib|/usr/lib64|/usr/share|/etc|/var|"$HOME"|"$canonical_home")
            log_error "Broad OpenCode mount is not allowed: $source"
            return 1 ;;
    esac
    if is_critical_system_dir "$source" && [[ "$source" != /usr/lib/meridian && "$source" != /usr/lib/meridian/* ]]; then
        log_error "Critical OpenCode mount is not allowed: $source"
        return 1
    fi
    local signature="$source:$mode"
    if [[ -n "${registry_ref[$destination]+present}" ]]; then
        [[ "${registry_ref[$destination]}" == "$signature" ]] && return 0
        log_error "Conflicting OpenCode mount: $destination"
        return 1
    fi
    registry_ref["$destination"]="$signature"
    output_ref+=(-v "$source:$destination:$mode")
}

is_path_within() {
    local path="$1" root="$2"
    if [[ "$root" == / ]]; then [[ "$path" == /* ]]; return; fi
    root="${root%/}"
    [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

track_opencode_writable_root() {
    local source="$1" destination="$2" canonical
    canonical=$(realpath -e -- "$source") || return 1
    OPENCODE_WRITABLE_SOURCES+=("$source" "$canonical")
    OPENCODE_WRITABLE_DESTINATIONS+=("$destination" "$destination")
}

is_opencode_writable_path() {
    local path="$1" root
    for root in "${OPENCODE_WRITABLE_SOURCES[@]}" "${OPENCODE_WRITABLE_DESTINATIONS[@]}"; do
        if is_path_within "$path" "$root"; then return 0; fi
    done
    return 1
}

find_opencode_package_root() {
    # The nameref writes the detected package root to the caller's variable.
    # shellcheck disable=SC2034
    local -n root_ref="$1"
    local file="$2" directory depth=0
    root_ref=""
    [[ -f "$file" ]] || return 0
    directory=${file%/*}
    [[ -n "$directory" ]] || directory=/
    while (( depth < 16 )); do
        if [[ -f "$directory/package.json" ]]; then
            root_ref="$directory"
            return 0
        fi
        [[ "$directory" == / ]] && return 0
        directory=${directory%/*}
        [[ -n "$directory" ]] || directory=/
        depth=$((depth + 1))
    done
}

mount_opencode_readonly_file_aliases() {
    local output_name="$1" registry_name="$2" lexical_file="$3"
    local canonical_file alias_source alias_destination relative candidate index
    canonical_file=$(realpath -e -- "$lexical_file") || {
        log_error "Missing OpenCode dependency: $lexical_file"
        return 1
    }
    append_opencode_mount "$output_name" "$lexical_file" "$lexical_file" ro "$registry_name" || return 1
    for ((index = 0; index < ${#OPENCODE_WRITABLE_SOURCES[@]}; index++)); do
        alias_source=${OPENCODE_WRITABLE_SOURCES[index]}
        alias_destination=${OPENCODE_WRITABLE_DESTINATIONS[index]}
        for candidate in "$lexical_file" "$canonical_file"; do
            if [[ "$candidate" == "$alias_source/"* ]]; then
                relative=${candidate#"$alias_source"/}
            elif [[ "$candidate" == "$alias_source" ]]; then
                continue
            else
                continue
            fi
            append_opencode_mount "$output_name" "$canonical_file" \
                "${alias_destination%/}/$relative" ro "$registry_name" || return 1
        done
    done
}

validate_opencode_server_args() {
    local argument skip_value=false
    for argument in "$@"; do
        if [[ "$skip_value" == true ]]; then skip_value=false; continue; fi
        case "$argument" in
            --) break ;;
            --server|--server=*)
                log_error "AgentBox OpenCode uses a private container server; --server is not supported."
                return 1 ;;
            --prompt|--session|-s|--model|-m|--agent|--format|--file|-f|--title|--data|-d|--header|-H|--param|--log-level|--completions)
                skip_value=true ;;
        esac
    done
}

build_network_args() {
    local -n network_ref="$1" publication_ref="$2" requested_ref="$4"
    network_ref=()
    # This output is populated indirectly by build_port_args for non-OpenCode tools.
    # shellcheck disable=SC2034
    publication_ref=()
    if [[ "$3" == opencode ]]; then
        network_ref+=(--network=host)
        if (( ${#requested_ref[@]} )); then log_warning "OpenCode uses host networking; -p mappings are ignored."; fi
    else
        build_port_args "$2" "$4"
    fi
}

build_herdr_args() {
    local output_name="$1"
    local -n mount_output="$output_name"
    mount_output=()
    [[ "${HERDR_ENV:-}" == 1 ]] || return 0
    local advertised="${HERDR_SOCKET_PATH:-}"
    if [[ -z "$advertised" || ! -S "$advertised" ]]; then
        log_warning "Herdr socket is unavailable: ${advertised:-<unset>}"
        return 0
    fi
    local resolved
    resolved=$(realpath -e -- "$advertised") || { log_warning "Herdr socket is unavailable: $advertised"; return 0; }
    [[ -S "$resolved" ]] || { log_warning "Herdr socket is unavailable: $advertised"; return 0; }
    local -A registry=()
    append_opencode_mount "$output_name" "$resolved" "$advertised" ro registry || return 1
    local name
    for name in HERDR_ENV HERDR_SOCKET_PATH HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID; do
        if [[ -v $name ]]; then mount_output+=(--env "$name=${!name}"); fi
    done
}

build_opencode_mounts() {
    local output_name="$1"
    # This nameref initializes the caller's array; subsequent additions use its name.
    # shellcheck disable=SC2178
    local -n mount_output="$output_name"
    local project_id="$2"
    mount_output=()
    OPENCODE_WRITABLE_SOURCES=()
    OPENCODE_WRITABLE_DESTINATIONS=()
    local cache_parent="$HOME/.cache/agentbox/$project_id"
    local cache_dir="$cache_parent/opencode"
    mkdir -p -- "$HOME/.config/opencode" "$HOME/.local/share/opencode" "$cache_dir" || return 1
    # append_opencode_mount consumes this associative array by name.
    # shellcheck disable=SC2034
    local -A registry=()
    local config="$HOME/.config/opencode" data="$HOME/.local/share/opencode"
    local config_real data_real
    config_real=$(realpath -e -- "$config") || return 1
    data_real=$(realpath -e -- "$data") || return 1
    append_opencode_mount "$output_name" "$config" "$config" rw registry || return 1
    append_opencode_mount "$output_name" "$config_real" "$config_real" rw registry || return 1
    append_opencode_mount "$output_name" "$config" /home/agent/.config/opencode rw registry || return 1
    append_opencode_mount "$output_name" "$data" "$data" rw registry || return 1
    append_opencode_mount "$output_name" "$data_real" "$data_real" rw registry || return 1
    append_opencode_mount "$output_name" "$data" /home/agent/.local/share/opencode rw registry || return 1
    append_opencode_mount "$output_name" "$cache_dir" /home/agent/.cache/opencode rw registry || return 1
    track_opencode_writable_root "$config" "$config" || return 1
    track_opencode_writable_root "$config_real" "$config_real" || return 1
    track_opencode_writable_root "$config" /home/agent/.config/opencode || return 1
    track_opencode_writable_root "$data" "$data" || return 1
    track_opencode_writable_root "$data_real" "$data_real" || return 1
    track_opencode_writable_root "$data" /home/agent/.local/share/opencode || return 1
    track_opencode_writable_root "$cache_dir" /home/agent/.cache/opencode || return 1
    for candidate in "${OPENCODE_BASE_MOUNTS[@]}"; do
        track_opencode_writable_root "$candidate" "$candidate" || return 1
    done
    for candidate in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
        if [[ -d "$candidate" ]]; then
            local skills_real
            skills_real=$(realpath -e -- "$candidate") || return 1
            append_opencode_mount "$output_name" "$candidate" "$candidate" ro registry || return 1
            append_opencode_mount "$output_name" "$skills_real" "$skills_real" ro registry || return 1
            if [[ "$candidate" == "$HOME/.claude/skills" ]]; then destination=/home/agent/.claude/skills; else destination=/home/agent/.agents/skills; fi
            append_opencode_mount "$output_name" "$candidate" "$destination" ro registry || return 1
        fi
    done
    local -a probe_mounts=() scan_args=()
    local -a config_symlink_targets=()
    local -a project_config_files=()
    local -A probe_registry=() all_records=()
    local candidate source destination
    for candidate in "$config" "$config_real"; do
        append_opencode_mount probe_mounts "$candidate" "$candidate" ro probe_registry || return 1
        scan_args+=(--scan "$candidate")
    done
    for candidate in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
        if [[ -d "$candidate" ]]; then
            append_opencode_mount probe_mounts "$candidate" "$candidate" ro probe_registry || return 1
            scan_args+=(--scan "$candidate")
        fi
    done
    local ancestor config_file
    ancestor="$PROJECT_DIR"
    while :; do
        candidate="$ancestor/.opencode"
        if [[ -d "$candidate" ]]; then
            append_opencode_mount probe_mounts "$candidate" "$candidate" ro probe_registry || return 1
            scan_args+=(--scan "$candidate")
        fi
        for config_file in "$ancestor/opencode.json" "$ancestor/opencode.jsonc" "$ancestor/.opencode/opencode.json" "$ancestor/.opencode/opencode.jsonc"; do
            if [[ -f "$config_file" || -L "$config_file" ]]; then
                project_config_files+=("$config_file")
                if [[ -L "$config_file" ]]; then
                    local link_path="$config_file" link_target link_value
                    while [[ -L "$link_path" ]]; do
                        link_value=$(readlink -- "$link_path") || { log_error "Cannot inspect OpenCode dependency: $link_path"; return 1; }
                        if [[ "$link_value" == /* ]]; then
                            link_target=$(realpath -m -- "$link_value") || return 1
                        else
                            link_target=$(realpath -m -- "$(dirname -- "$link_path")/$link_value") || return 1
                        fi
                        if [[ "$link_target" == *:* || "$link_target" == *$'\t'* || "$link_target" == *$'\r'* || "$link_target" == *$'\n'* ]]; then
                            log_error "Unsupported OpenCode mount path or mode."
                            return 1
                        fi
                        config_symlink_targets+=("$link_target")
                        if [[ -e "$link_target" ]]; then
                            append_opencode_mount probe_mounts "$link_target" "$link_target" ro probe_registry || return 1
                            scan_args+=(--scan "$link_target")
                        else
                            break
                        fi
                        link_path="$link_target"
                    done
                else
                    append_opencode_mount probe_mounts "$config_file" "$config_file" ro probe_registry || return 1
                fi
            fi
        done
        [[ "$ancestor" == / ]] && break
        ancestor=$(dirname -- "$ancestor")
    done
    for candidate in "${config_symlink_targets[@]}"; do
        all_records["$candidate"]='ro:symlink:1'
    done
    for candidate in "${project_config_files[@]}"; do
        all_records["$candidate"]='ro:root:1'
    done
    local probe_parent="$cache_parent" probe_dir manifest_file
    mkdir -p -- "$probe_parent" || return 1
    probe_dir=$(mktemp -d "$probe_parent/opencode-discovery.XXXXXX") || return 1
    manifest_file="$probe_dir/manifest.tsv"
    local previous_return_trap
    previous_return_trap=$(trap -p RETURN)
    trap 'rm -rf -- "$probe_dir"; if [[ -n "$previous_return_trap" ]]; then eval "$previous_return_trap"; else trap - RETURN; fi' RETURN
    local -a probe_runtime_args=()
    [[ "$RUNTIME" == podman ]] && probe_runtime_args+=(--userns=keep-id)
    local pass=0 changed=true record_mode record_role record_required dependency
    while [[ "$changed" == true && $pass -lt 32 ]]; do
        pass=$((pass + 1)); changed=false
        # shellcheck disable=SC2016
        if ! "$RUNTIME" run --rm --network=none --read-only --cap-drop=ALL --security-opt=no-new-privileges \
            "${probe_runtime_args[@]}" "${probe_mounts[@]}" --entrypoint /bin/bash "$IMAGE_NAME" \
            -c 'source "$NVM_DIR/nvm.sh"; exec node /usr/local/lib/agentbox/opencode-dependencies.cjs "$@"' \
            agentbox-discovery --home "$HOME" --config "$HOME/.config/opencode" --project "$PROJECT_DIR" \
            "${scan_args[@]}" >"$manifest_file"; then
            log_error "OpenCode dependency probe failed."
            return 1
        fi
        while IFS= read -r manifest_record; do
            [[ -z "$manifest_record" ]] && continue
            local manifest_without_tabs=${manifest_record//$'\t'/}
            if (( ${#manifest_record} - ${#manifest_without_tabs} != 3 )); then
                log_error "Invalid OpenCode dependency manifest record."
                return 1
            fi
            IFS=$'\t' read -r record_mode record_role record_required dependency <<< "$manifest_record"
            if [[ "$record_mode" != ro && "$record_mode" != rw ]] ||
                [[ "$record_role" != root && "$record_role" != plugin && "$record_role" != skills && "$record_role" != file && "$record_role" != symlink ]] ||
                [[ "$record_required" != 0 && "$record_required" != 1 ]] || [[ "$dependency" != /* ]] ||
                [[ "$dependency" == *$'\n'* || "$dependency" == *$'\r'* || "$dependency" == *$'\t'* || "$dependency" == *:* ]]; then
                log_error "Invalid OpenCode dependency manifest record."
                return 1
            fi
            if [[ "$record_required" == 1 && ! -e "$dependency" ]]; then
                log_error "Missing OpenCode dependency: $dependency"
                return 1
            fi
            if [[ "$record_role" == plugin && -f "$dependency" ]]; then
                local package_root
                find_opencode_package_root package_root "$dependency" || return 1
                if [[ -n "$package_root" ]]; then dependency="$package_root"; fi
                record_role=plugin
                record_mode=ro
            fi
            if [[ -n "${all_records[$dependency]+present}" ]]; then
                local previous=${all_records[$dependency]}
                local previous_mode=${previous%%:*} previous_role=${previous#*:}
                previous_role=${previous_role%%:*}
                local previous_required=${previous##*:} merged_mode="$record_mode" merged_role="$record_role" merged_required="$record_required"
                if [[ "$previous_role" == file || "$record_role" == file ]]; then
                    merged_mode=ro
                    merged_role='file'
                elif [[ "$previous_mode" == rw || "$record_mode" == rw ]]; then
                    merged_mode=rw
                fi
                [[ "$previous_required" == 1 || "$record_required" == 1 ]] && merged_required=1
                all_records["$dependency"]="$merged_mode:$merged_role:$merged_required"
            else
                all_records["$dependency"]="$record_mode:$record_role:$record_required"
            fi
            if [[ -e "$dependency" ]]; then
                local lexical="$dependency"
                local canonical
                canonical=$(realpath -e -- "$dependency") || { log_error "Missing OpenCode dependency: $dependency"; return 1; }
                for source in "$lexical" "$canonical"; do
                    if [[ -z "${probe_registry[$source]+present}" ]]; then
                        append_opencode_mount probe_mounts "$source" "$source" ro probe_registry || return 1
                        scan_args+=(--scan "$source")
                        changed=true
                    fi
                done
            fi
        done < "$manifest_file"
    done
    if [[ "$changed" == true ]]; then log_error "OpenCode dependency closure exceeded 32 passes."; return 1; fi
    local -a ordered=()
    for dependency in "${!all_records[@]}"; do ordered+=("$dependency"); done
    while IFS= read -r dependency; do
        [[ -z "$dependency" ]] && continue
        local details=${all_records[$dependency]} mode=${all_records[$dependency]%%:*}
        local role=${details#*:}; role=${role%%:*}
        local required=${details##*:}
        if [[ "$required" == 0 && ! -e "$dependency" ]]; then continue; fi
        [[ "$role" == file ]] && continue
        if is_opencode_writable_path "$dependency"; then continue; fi
        destination="$dependency"
        append_opencode_mount "$output_name" "$dependency" "$destination" "$mode" registry || return 1
        if [[ "$role" == root && -d "$dependency" ]]; then
            local canonical_root
            canonical_root=$(realpath -e -- "$dependency") || return 1
            if [[ "$canonical_root" != "$dependency" ]]; then
                append_opencode_mount "$output_name" "$dependency" "$canonical_root" "$mode" registry || return 1
                if [[ "$mode" == rw ]]; then track_opencode_writable_root "$dependency" "$canonical_root" || return 1; fi
            fi
            if [[ "$mode" == rw ]]; then track_opencode_writable_root "$dependency" "$dependency" || return 1; fi
        fi
    done < <(printf '%s\n' "${ordered[@]}" | LC_ALL=C sort)
    while IFS= read -r dependency; do
        [[ -z "$dependency" ]] && continue
        local details=${all_records[$dependency]} role=${all_records[$dependency]#*:}
        role=${role%%:*}
        [[ "$role" == file ]] || continue
        local required=${details##*:}
        if [[ "$required" == 0 && ! -e "$dependency" ]]; then continue; fi
        mount_opencode_readonly_file_aliases "$output_name" registry "$dependency" || return 1
    done < <(printf '%s\n' "${ordered[@]}" | LC_ALL=C sort)
    if [[ -n "$previous_return_trap" ]]; then eval "$previous_return_trap"; else trap - RETURN; fi
    rm -rf -- "$probe_dir"
}

build_env_file_args() {
    local -n env_args_ref=$1
    local ignore_dot_env="$2"

    env_args_ref=()
    if [[ "$ignore_dot_env" == "true" ]]; then
        log_info ".env files not loaded (--ignore-dot-env flag set)"
        return
    fi

    local agentbox_env="${HOME}/.agentbox/.env"
    if [[ -f "$agentbox_env" ]]; then
        env_args_ref+=(--env-file "$agentbox_env")
        log_info "Global .env loaded from ~/.agentbox/.env"
    fi

    if [[ -f "$PROJECT_DIR/.env" ]]; then
        env_args_ref+=(--env-file "$PROJECT_DIR/.env")
        log_info "Project .env loaded from $PROJECT_DIR/.env"
    fi
}

build_extra_host_args() {
    local -n host_args_ref=$1

    host_args_ref=()
    local agentbox_env="${HOME}/.agentbox/.env"
    if [[ ! -f "$agentbox_env" ]]; then
        return
    fi

    local extra_hosts
    extra_hosts=$(grep -E '^AGENTBOX_EXTRA_HOSTS=' "$agentbox_env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" || true)
    if [[ -z "$extra_hosts" ]]; then
        return
    fi

    IFS=',' read -ra host_entries <<< "$extra_hosts"
    for entry in "${host_entries[@]}"; do
        entry=$(echo "$entry" | xargs)
        if [[ -n "$entry" ]]; then
            host_args_ref+=(--add-host "$entry")
            log_info "Extra host: $entry"
        fi
    done
}

build_port_args() {
    local -n port_args_ref=$1
    local -n ports_ref=$2

    port_args_ref=()
    for port in "${ports_ref[@]}"; do
        if [[ "$port" =~ ^[0-9]+$ ]]; then
            port_args_ref+=(-p "${port}:${port}")
            log_info "Port forwarding: ${port} -> ${port}"
        elif [[ "$port" =~ ^[0-9]+:[0-9]+$ ]]; then
            port_args_ref+=(-p "${port}")
            log_info "Port forwarding: ${port}"
        else
            log_warning "Invalid port format: ${port} (use '3002' or '3002:8080')"
        fi
    done
}

run_container() {
    local container_name="$1"
    local project_id="$2"
    local -n extra_dirs_to_mount=$3
    local tool="$4"
    local ignore_dot_env="$5"
    local shell_mode="$6"
    local admin_mode="$7"
    local -n ports_to_forward=$8
    local parent_mode="$9"
    shift 9
    local cmd_args=("$@")

    if [[ "$tool" == opencode && "$shell_mode" != true ]]; then
        validate_opencode_server_args "${cmd_args[@]}" || return 1
    fi

    if [[ "$admin_mode" == "true" ]]; then
        log_success "Starting container for: $PROJECT_NAME (admin shell)"
    else
        log_success "Starting container for: $PROJECT_NAME"
    fi

    local mount_dir="$PROJECT_DIR"
    if [[ "$parent_mode" == "true" ]]; then
        mount_dir="$(dirname "$PROJECT_DIR")"
        log_info "Parent mode: mounting $mount_dir (working directory: $PROJECT_DIR)"
    fi

    local mount_opts=()
    build_mount_opts mount_opts "$project_id" "$tool" extra_dirs_to_mount "$mount_dir" || return 1

    local container_cmd=()
    build_container_cmd container_cmd "$shell_mode" "$admin_mode" "$tool" "${cmd_args[@]}"

    local env_file_args=()
    build_env_file_args env_file_args "$ignore_dot_env"

    local host_args=()
    build_extra_host_args host_args

    local network_args=() port_args=()
    build_network_args network_args port_args "$tool" ports_to_forward

    local runtime_args=()
    if [[ "$RUNTIME" == "podman" ]]; then
        runtime_args+=(--userns=keep-id)
    fi

    $RUNTIME run -it --rm \
        --name "$container_name" \
        --hostname "agentbox-$PROJECT_NAME" \
        "${runtime_args[@]}" \
        "${host_args[@]}" \
        "${network_args[@]}" \
        "${port_args[@]}" \
        "${mount_opts[@]}" \
        "${env_file_args[@]}" \
        -w "$PROJECT_DIR" \
        --init \
        "$IMAGE_NAME" \
        "${container_cmd[@]}"
}

# Show help
show_help() {
    cat << EOF
AgentBox - Simplified container environment for Claude development

Usage:
    agentbox [OPTIONS] [COMMAND]

Options:
    -h, --help              Show this help message
    --tool TOOL             Choose tool: claude (default) or opencode
    -p PORT                 Forward a port from host to container (can be used multiple times)
    --rebuild               Force rebuild of the image
    --parent                Mount parent directory instead of current directory (cwd unchanged)
    --add-dir DIR           Mount additional directory (can be used multiple times)
    --ignore-dot-env        Do not load .env files as environment variables (still mounted)

Commands:
    shell [--admin]         Start interactive shell instead of Claude CLI
    ssh-init                Initialize SSH directory for AgentBox

    If no command is provided, Claude CLI will be started automatically.
    Use 'shell' command to get a shell instead of Claude CLI.
    Use 'shell --admin' to get a shell with sudo privileges.
    Other commands will be executed inside the container.

Examples:
    agentbox                            # Start Claude CLI for current project
    agentbox --tool opencode            # Start OpenCode instead of Claude
    agentbox -p 3002                    # Forward port 3002
    agentbox -p 3002:8080               # Map host port 3002 to container port 8080
    agentbox shell                      # Start interactive shell instead of Claude
    agentbox shell --admin              # Start admin shell with sudo access
    agentbox --parent                      # Mount parent dir (access sibling repos)
    agentbox --add-dir ~/1 --add-dir ~/2  # Add dirs with Claude CLI
    agentbox python script.py           # Run Python script in container
    agentbox --rebuild                  # Force rebuild image
    agentbox ssh-init                   # Set up SSH for AgentBox
    AGENTBOX_TOOL=opencode agentbox     # Use env var to select tool

Environment variables (set in ~/.agentbox/.env):
    AGENTBOX_EXTRA_HOSTS    Comma-separated host:ip pairs added to container /etc/hosts
                            Example: gitlab.example.com:host-gateway

Containers are ephemeral and automatically removed when you exit.
Package caches and shell history persist between sessions.

All directories are mounted at their full host paths for symlink/path compatibility.

Container Runtime:
    Auto-detected (Docker preferred, Podman fallback)
EOF
}

# Set up dedicated SSH directory for AgentBox
ssh_setup() {
    local agentbox_ssh="${HOME}/.agentbox/ssh"

    log_info "Setting up AgentBox SSH directory..."
    mkdir -p "${agentbox_ssh}"
    chmod 700 "${agentbox_ssh}"

    # Copy known_hosts if it exists
    if [[ -f "${HOME}/.ssh/known_hosts" ]]; then
        cp "${HOME}/.ssh/known_hosts" "${agentbox_ssh}/known_hosts"
        chmod 600 "${agentbox_ssh}/known_hosts"
        log_success "Copied known_hosts from ~/.ssh"
    fi

    # Check if AgentBox key already exists
    if [[ -f "${agentbox_ssh}/id_ed25519" ]]; then
        log_info "AgentBox SSH key already exists"
    else
        log_info "Generating dedicated SSH key for AgentBox..."
        ssh-keygen -t ed25519 -f "${agentbox_ssh}/id_ed25519" -C "agentbox@$(hostname)" -N ""
        log_success "Generated new SSH key: ${agentbox_ssh}/id_ed25519"
        echo ""
        log_info "Add this public key to your Git provider:"
        echo ""
        cat "${agentbox_ssh}/id_ed25519.pub"
        echo ""
        log_info "Alternatively, replace the keys in ${agentbox_ssh}/ with your desired keys"
    fi

    log_success "SSH setup complete! Directory: ${agentbox_ssh}"
    log_info "AgentBox will use this directory for all SSH operations."
}

# Main execution
main() {
    # Parse arguments
    local force_rebuild=false
    local shell_mode=false
    local admin_mode=false
    local parent_mode=false
    local cmd_args=()
    declare -a ports=()
    local extra_dirs=()
    local tool="${AGENTBOX_TOOL:-claude}"
    local ignore_dot_env=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            --rebuild)
                force_rebuild=true
                shift
                ;;
            -p)
                shift
                if [[ -z "${1:-}" ]]; then
                    log_error "Port argument requires a value"
                    exit 1
                fi
                ports+=("$1")
                shift
                ;;
            --add-dir)
                shift
                if [[ -z "${1:-}" ]]; then
                    log_error "--add-dir requires a directory path"
                    exit 1
                fi
                extra_dirs+=("$1")
                shift
                ;;
            --tool)
                shift
                if [[ -z "${1:-}" ]]; then
                    log_error "--tool requires a value (claude or opencode)"
                    exit 1
                fi
                tool="$1"
                shift
                ;;
            --parent)
                parent_mode=true
                shift
                ;;
            --ignore-dot-env)
                ignore_dot_env=true
                shift
                ;;
            shell)
                shell_mode=true
                shift
                # Check if next arg is --admin
                if [[ "${1:-}" == "--admin" ]]; then
                    admin_mode=true
                    shift
                fi
                # Remaining args become shell commands
                cmd_args=("$@")
                break
                ;;
            ssh-init)
                ssh_setup
                exit 0
                ;;
            *)
                cmd_args+=("$1")
                shift
                ;;
        esac
    done

    # Validate tool selection
    if [[ "$tool" != "claude" && "$tool" != "opencode" ]]; then
        log_error "Invalid tool: $tool (must be 'claude' or 'opencode')"
        exit 1
    fi

    OPENCODE_VERSION=$(select_opencode_version "$tool") || exit 1

    # Check runtime
    RUNTIME=$(check_runtime)
    log_info "Using container runtime: $RUNTIME"

    local project_id=$(get_project_id)
    local container_name=$(get_container_name "$project_id")

    # Validate dir paths (batch all errors so user sees all problems at once)
    local project_realpath
    if [[ "$parent_mode" == "true" ]]; then
        project_realpath=$(realpath "$(dirname "$PROJECT_DIR")")
    else
        project_realpath=$(realpath "$PROJECT_DIR")
    fi
    local validated_dirs=()
    local validation_failed=false
    for dir in "${extra_dirs[@]}"; do
        if ! validate_dir_path "$dir" validated_dirs "$project_realpath"; then
            validation_failed=true
        fi
    done

    if [[ "$validation_failed" == "true" ]]; then
        exit 1
    fi

    # Check if rebuild is needed or forced
    if [[ "$force_rebuild" == "true" ]] || needs_rebuild; then
        if [[ "$force_rebuild" == "true" ]]; then
            log_info "Forcing image rebuild..."
        else
            log_info "Dockerfile or entrypoint changed, rebuilding automatically..."
        fi

        if ! build_image; then
            log_error "Build failed!"
            exit 1
        fi
    fi

    run_container "$container_name" "$project_id" validated_dirs "$tool" "$ignore_dot_env" "$shell_mode" "$admin_mode" ports "$parent_mode" "${cmd_args[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
